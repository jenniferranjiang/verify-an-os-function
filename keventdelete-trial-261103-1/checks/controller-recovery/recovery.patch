+def _reopen_infrastructure_group(state: dict, identifier: str, reason: str):
+    """Requeue exactly one resolved infrastructure failure for its original owner.
+
+    This never accepts a proof or clears semantic blockers. The caller supplies
+    the resolution evidence; normal claim and full acceptance remain mandatory.
+    """
+    from controller_attempts import _task
+    if not reason.strip():
+        raise SystemExit("--resolved-attempt requires a non-empty --resolution-reason")
+    attempt, record, group = _task(state, identifier, assignment=False)
+    if (group is None or state["phase"] != "vc-proving"
+            or state["current"].get("vc-proving") != attempt["attempt_id"]):
+        raise SystemExit("resolution must name a group in the current proving attempt")
+    blocker = record.get("blocker", {})
+    if record["status"] != "blocked" or blocker.get("failure_class") != "infrastructure":
+        raise SystemExit("only a blocked infrastructure group can be reopened")
+    record.update(status="prepared", repair_index=record.get("repair_index", 0) + 1,
+                  feedback="Infrastructure resolution: " + reason.strip(), claimed_action=None)
+    for field in ("started_at", "returned_at", "finished_at", "blocker"):
+        record.pop(field, None)
+    state["current_blockers"] = [item for item in state.get("current_blockers", []) if item != blocker]
+    return attempt, group, blocker
