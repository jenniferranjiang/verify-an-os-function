store_ptr =
fun (x : CNotation.addr) (v : Z) =>
(“ CommonAssertion.isvalidptr x /\ v >= 0 /\ v <= Integers.Int.max_unsigned ” &&
 store_4byte x v)%sac
     : CNotation.addr -> Z -> model -> Prop

Arguments store_ptr x v%Z_scope m
undef_store_ptr =
fun x : CNotation.addr =>
(“ CommonAssertion.isvalidptr x ” && store_4byte_noninit x)%sac
     : CNotation.addr -> model -> Prop

Arguments undef_store_ptr x m
store_ushort =
fun (x : CNotation.addr) (v : Z) =>
(“ CommonAssertion.isvalidptr_short x /\ v >= 0 /\ v <= 65535 ” &&
 store_2byte x v)%sac
     : CNotation.addr -> Z -> model -> Prop

Arguments store_ushort x v%Z_scope m
store_4byte =
fun (x : CNotation.addr) (v : Z) =>
(EX z1 : Z,
 EX z2 : Z,
 EX z3 : Z,
 EX z4 : Z,
 “ CommonAssertion.merge_int z1 z2 z3 z4 v ” &&
 store_byte x z1 **
 (store_byte (x + 1) z2 ** (store_byte (x + 2) z3 ** store_byte (x + 3) z4)))%sac
     : CNotation.addr -> Z -> Assertion

Arguments store_4byte x v%Z_scope _
store_2byte =
fun (x : CNotation.addr) (v : Z) =>
(EX z1 : Z,
 EX z2 : Z,
 “ CommonAssertion.merge_short z1 z2 v ” &&
 store_byte x z1 ** store_byte (x + 1) z2)%sac
     : CNotation.addr -> Z -> Assertion

Arguments store_2byte x v%Z_scope _
CommonAssertion.merge_int =
fun x1 x2 x3 x4 y : Z =>
y mod 2 ^ 32 =
x1 mod 2 ^ 8 * 2 ^ 24 + x2 mod 2 ^ 8 * 2 ^ 16 + x3 mod 2 ^ 8 * 2 ^ 8 +
x4 mod 2 ^ 8
     : Z -> Z -> Z -> Z -> Z -> Prop

Arguments CommonAssertion.merge_int (x1 x2 x3 x4 y)%Z_scope
CommonAssertion.merge_short =
fun x1 x2 y : Z => y mod 2 ^ 16 = x1 mod 2 ^ 8 * 2 ^ 8 + x2 mod 2 ^ 8
     : Z -> Z -> Z -> Prop

Arguments CommonAssertion.merge_short (x1 x2 y)%Z_scope
Crtos_C_Rules.store_ptr =
fun (x : CNotation.addr) (v : Z) =>
Crtos_C_Rules.andp
  (Crtos_C_Rules.coq_prop
     (CommonAssertion.isvalidptr x /\
      v >= 0 /\ v <= Integers.Int.max_unsigned))
  (Crtos_C_Rules.store_4byte x v)
     : CNotation.addr -> Z -> Crtos_C_Rules.model -> Prop

Arguments Crtos_C_Rules.store_ptr x v%Z_scope m
Crtos_C_Rules.store_ushort =
fun (x : CNotation.addr) (v : Z) =>
Crtos_C_Rules.andp
  (Crtos_C_Rules.coq_prop
     (CommonAssertion.isvalidptr_short x /\ v >= 0 /\ v <= 65535))
  (Crtos_C_Rules.store_2byte x v)
     : CNotation.addr -> Z -> Crtos_C_Rules.model -> Prop

Arguments Crtos_C_Rules.store_ushort x v%Z_scope m
     = 1 = 1
     : Prop
     = 1 = 256
     : Prop
