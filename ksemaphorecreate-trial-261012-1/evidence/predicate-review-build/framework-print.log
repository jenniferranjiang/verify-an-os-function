CrtosCritical.OutsideCritical =
fun s : CriticalSTS.critical_STS_state =>
Crtos_C_Rules.exp
  (fun s' : CriticalSTS.critical_STS_state =>
   Crtos_C_Rules.andp
     (Crtos_C_Rules.coq_prop (CriticalSTS.critical_STS_transition s s'))
     (Crtos_C_Rules.at_states
        (fun cs : ConAssertion.STS_state =>
         exists s'' : CriticalSTS.critical_STS_state,
           cs = CriticalSTS.outside_state s'' /\
           CriticalSTS.critical_STS_transition s' s'')))
     : CriticalSTS.critical_STS_state -> Crtos_C_Rules.expr

Arguments CrtosCritical.OutsideCritical s _
CrtosCritical.InsideCritical =
fun s : CriticalSTS.critical_STS_state =>
Crtos_C_Rules.sepcon
  (Crtos_C_Rules.at_states
     (SetsDomain.Sets.singleton (CriticalSTS.inside_state s)))
  (Crtos_C_Rules.has_tokens SetsDomain.Sets.full)
     : CriticalSTS.critical_STS_state -> Crtos_C_Rules.expr

Arguments CrtosCritical.InsideCritical s _
