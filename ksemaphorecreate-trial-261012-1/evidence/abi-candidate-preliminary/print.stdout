store_ptr =
fun (x : CNotation.addr) (v : Z) =>
(“ isvalidptr x /\ valid_ptr_value v ” &&
 match ptr_size with
 | 4%nat => store_4byte x v
 | 8%nat => store_8byte x v
 | _ => “ False ”
 end)%sac
     : CNotation.addr -> Z -> model -> Prop

Arguments store_ptr x v%Z_scope m
undef_store_ptr =
fun x : CNotation.addr =>
(“ isvalidptr x ” &&
 match ptr_size with
 | 4%nat => store_4byte_noninit x
 | 8%nat => store_8byte_noninit x
 | _ => “ False ”
 end)%sac
     : CNotation.addr -> model -> Prop

Arguments undef_store_ptr x m
store_uint =
fun (x : CNotation.addr) (v : Z) =>
(“ isvalidptr_int x /\ v >= 0 /\ v <= Integers.Int.max_unsigned ” &&
 store_4byte x v)%sac
     : CNotation.addr -> Z -> model -> Prop

Arguments store_uint x v%Z_scope m
store_ushort =
fun (x : CNotation.addr) (v : Z) =>
(“ isvalidptr_short x /\ v >= 0 /\ v <= 65535 ” && store_2byte x v)%sac
     : CNotation.addr -> Z -> model -> Prop

Arguments store_ushort x v%Z_scope m
store_4byte =
fun (x : CNotation.addr) (v : Z) =>
(EX z1 : Z,
 EX z2 : Z,
 EX z3 : Z,
 EX z4 : Z,
 “ merge_int z1 z2 z3 z4 v ” &&
 store_byte x z1 **
 (store_byte (x + 1) z2 ** (store_byte (x + 2) z3 ** store_byte (x + 3) z4)))%sac
     : CNotation.addr -> Z -> Assertion

Arguments store_4byte x v%Z_scope _
store_2byte =
fun (x : CNotation.addr) (v : Z) =>
(EX z1 : Z,
 EX z2 : Z,
 “ merge_short z1 z2 v ” && store_byte x z1 ** store_byte (x + 1) z2)%sac
     : CNotation.addr -> Z -> Assertion

Arguments store_2byte x v%Z_scope _
