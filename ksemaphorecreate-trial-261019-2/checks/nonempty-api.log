     Definition mstore : CNotation.addr -> BinNums.Z -> expr.
     Definition mstore_noninit : CNotation.addr -> expr.
     Parameter mstore_mstore_noninit :
       forall (p : CNotation.addr) (v : BinNums.Z) (m : model),
       mstore p v m -> mstore_noninit p m.
     Parameter mstore_eqm :
       forall (p : CNotation.addr) (v v' : BinNums.Z),
       Integers.Byte.eqm v v' -> derivable1 (mstore p v) (mstore p v').
     Parameter dup_mstore_noninit :
       forall p : CNotation.addr,
       derivable1 (sepcon (mstore_noninit p) (mstore_noninit p))
         (coq_prop False).
