task_wakeup_inv : StableGlobalState -> VarGlobalState -> Assertion
     : StableGlobalState -> VarGlobalState -> Assertion
fun (sg : StableGlobalState) (st : VarGlobalState) =>
eq_refl
:
task_wakeup_inv sg st =
task_fields sg st ** delay_inv sg st ** assign_ready_pending sg st
     : forall (sg : StableGlobalState) (st : VarGlobalState),
       task_wakeup_inv sg st =
       task_fields sg st ** delay_inv sg st ** assign_ready_pending sg st
