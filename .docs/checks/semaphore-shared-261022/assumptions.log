store_2byte =
fun (x : CNotation.addr) (v : BinNums.Z) =>
(EX z1 : BinNums.Z,
 EX z2 : BinNums.Z,
 “ merge_short z1 z2 v ” &&
 store_byte x z1 ** store_byte (BinInt.Z.add x (BinNums.Zpos BinNums.xH)) z2)%sac
     : CNotation.addr -> BinNums.Z -> Assertion

Arguments store_2byte x v%Z_scope _
