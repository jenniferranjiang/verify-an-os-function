first_free_from_some_min
     : forall (fuel : nat) (start : BinNums.Z) (m : VarIdmanager)
         (free : BinNums.Z),
       idmanager_first_free_id_from m fuel start = Some free ->
       (BinInt.Z.le start free /\
        BinInt.Z.lt free (BinInt.Z.add start (BinInt.Z.of_nat fuel))) /\
       idmanager_query m free = false /\
       (forall id : BinNums.Z,
        BinInt.Z.le start id /\ BinInt.Z.lt id free ->
        idmanager_query m id = true)
