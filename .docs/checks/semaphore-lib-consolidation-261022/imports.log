       idmanager_first_free_id_from m fuel start = None <->
       (forall id : BinNums.Z,
        BinInt.Z.le start id /\
        BinInt.Z.lt id (BinInt.Z.add start (BinInt.Z.of_nat fuel)) ->
        idmanager_query m id = true)
