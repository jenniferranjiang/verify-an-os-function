priority : core(2)
left : store_task_sched_except_cur_prio(?task, ?info) at 0
       store(field_addr(field_addr(?q, TaskDescriptor, task_dync_sched_member), TaskDyncSchedMember, cur_prio), U8, ?value) at 1
right : store_task_sched_member(?p, info) at 2
check : infer(q == task); infer(value == tsmCurPrio(info));
