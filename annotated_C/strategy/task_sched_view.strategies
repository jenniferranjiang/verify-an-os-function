// 同一 task 先后读取 prio/bitmap 时继续借出第二槽，不重开 invariant。
id : 19
priority : core(2)
left : store_task_sched_except_cur_prio(?task, ?info) at 0
right : store(field_addr(field_addr(?q, TaskDescriptor, task_dync_sched_member), TaskDyncSchedMember, bitmap_column), U32, ?value) at 1
check : infer(q == task);
action : left_erase(0); right_erase(1);
         left_add(store_assign_remove_sched_frame(task, info));
         right_add(value == tsmBitmapColumn(info));

id : 20
priority : core(2)
left : store_task_sched_except_bitmap_column(?task, ?info) at 0
right : store(field_addr(field_addr(?q, TaskDescriptor, task_dync_sched_member), TaskDyncSchedMember, cur_prio), U8, ?value) at 1
check : infer(q == task);
action : left_erase(0); right_erase(1);
         left_add(store_assign_remove_sched_frame(task, info));
         right_add(value == tsmCurPrio(info));

// task_fields 不拥有 ready-vector；去掉无关的 ready 更新，降低状态表达式深度。
id : 21
priority : post(4)
left : task_fields(?sg, replace_global_ready_vector(?ready, ?st)) at 0
action : left_erase(0); left_add(task_fields(sg, st));

// 写 cur_prio 不要求旧值，但必须持有目标 task 的权威 map cell。
id : 25
priority : core(3)
left : task_fields(?sg, ?st) at 0
       task_desc_map(os_tasks(st), ?task) == Some{TaskDescriptorAbs}(?desc) at 1
right : undef_data_at(field_addr(field_addr(?q, TaskDescriptor, task_dync_sched_member), TaskDyncSchedMember, cur_prio), U8) at 2
check : infer(q == task);
action : left_erase(0);
         left_add(task_fields_except_sched(sg, st, task, desc));
         left_add(store_task_sched_member(sched_link_of(task), tdSchedMember(desc)));

id : 26
priority : core(2)
left : store_task_sched_member(?p, ?info) at 0
right : undef_data_at(field_addr(field_addr(?task, TaskDescriptor, task_dync_sched_member), TaskDyncSchedMember, cur_prio), U8) at 1
check : infer(p == sched_link_of(task));
action : left_erase(0); right_erase(1);
         left_add(store_task_sched_except_cur_prio(task, info));

// cur_prio 已被借出或写入后，bitmap 的写权限来自同一字段组的补集。
id : 27
priority : core(2)
left : store_task_sched_except_cur_prio(?task, ?info) at 0
right : undef_data_at(field_addr(field_addr(?q, TaskDescriptor, task_dync_sched_member), TaskDyncSchedMember, bitmap_column), U32) at 1
check : infer(q == task);
action : left_erase(0); right_erase(1);
         left_add(store_assign_remove_sched_frame(task, info));

// 将已更新的两字段连同未触及的四字段重新封装，不提前更新全局状态。
id : 28
priority : post(2)
left : store_assign_remove_sched_frame(?task, ?info) at 0
       store(field_addr(field_addr(?q, TaskDescriptor, task_dync_sched_member), TaskDyncSchedMember, cur_prio), U8, ?prio) at 1
       store(field_addr(field_addr(?q2, TaskDescriptor, task_dync_sched_member), TaskDyncSchedMember, bitmap_column), U32, ?bitmap) at 2
check : infer(q == task); infer(q2 == task);
action : left_erase(0); left_erase(1); left_erase(2);
         left_add(store_task_sched_member(sched_link_of(task), mkTaskSchedMemberAbs(tsmStat(info), tsmAdvanceCnt(info), prio, tsmOriginTimeslice(info), tsmRestTimeslice(info), bitmap)));

id : 22
priority : core(3)
left : task_fields(?sg, ?st) at 0
right : task_fields(sg, replace_global_ready_vector(?ready, st)) at 1
action : left_erase(0); right_erase(1);

id : 23
priority : core(3)
left : task_fields(?sg, replace_global_ready_vector(?ready, ?st)) at 0
right : task_fields(sg, st) at 1
action : left_erase(0); right_erase(1);

// 某些 C 直读不会先运行 post；该需求规则只减少一个无关 ready 更新层。
id : 24
priority : core(4)
left : task_fields(?sg, replace_global_ready_vector(?ready, ?st)) at 0
right : store(field_addr(field_addr(?q, TaskDescriptor, task_dync_sched_member), TaskDyncSchedMember, cur_prio), U8, ?value) at 1
action : left_erase(0); left_add(task_fields(sg, st));

// 单个 descriptor 的只读借还；全局其他资源和该任务栈保存在 wand frame。
id : 29
priority : core(3)
left : task_fields(?sg, ?st) at 0
       task_desc_map(os_tasks(st), ?task) == Some{TaskDescriptorAbs}(?desc) at 1
right : store_task_descriptor(task, desc) at 2
action : left_erase(0); right_erase(2);
         left_add(task_fields_descriptor_frame(sg, st, task, desc));

id : 30
priority : post(3)
left : task_fields_descriptor_frame(?sg, ?st, ?task, ?desc) at 0
       store_task_descriptor(task, desc) at 1
action : left_erase(0); left_erase(1);
         left_add(task_fields(sg, st));

id : 31
priority : core(3)
left : task_fields_descriptor_frame(?sg, ?st, ?task, ?desc) at 0
       store_task_descriptor(task, desc) at 1
right : task_fields(sg, st) at 2
action : left_erase(0); left_erase(1); right_erase(2);

// descriptor 只在实际字段需求出现时借出六标量层，复用已有单字段补集。
id : 32
priority : core(3)
left : store_task_descriptor(?task, ?desc) at 0
right : store(field_addr(field_addr(?q, TaskDescriptor, task_dync_sched_member), TaskDyncSchedMember, cur_prio), U8, ?value) at 1
check : infer(q == task);
action : left_erase(0); right_erase(1);
         left_add(task_descriptor_sched_frame(task, desc));
         left_add(store_task_sched_except_cur_prio(task, tdSchedMember(desc)));
         right_add(value == tsmCurPrio(tdSchedMember(desc)));

id : 33
priority : core(3)
left : store_task_descriptor(?task, ?desc) at 0
right : store(field_addr(field_addr(?q, TaskDescriptor, task_dync_sched_member), TaskDyncSchedMember, bitmap_column), U32, ?value) at 1
check : infer(q == task);
action : left_erase(0); right_erase(1);
         left_add(task_descriptor_sched_frame(task, desc));
         left_add(store_task_sched_except_bitmap_column(task, tdSchedMember(desc)));
         right_add(value == tsmBitmapColumn(tdSchedMember(desc)));

// 标量组按原值归还后恢复 descriptor，再由外层规则恢复 task_fields。
id : 34
priority : post(3)
left : task_descriptor_sched_frame(?task, ?desc) at 0
       store_task_sched_member(?p, ?info) at 1
check : infer(p == sched_link_of(task)); infer(info == tdSchedMember(desc));
action : left_erase(0); left_erase(1);
         left_add(store_task_descriptor(task, desc));

id : 35
priority : core(3)
left : task_descriptor_sched_frame(?task, ?desc) at 0
       store_task_sched_member(?p, ?info) at 1
right : store_task_descriptor(task, desc) at 2
check : infer(p == sched_link_of(task)); infer(info == tdSchedMember(desc));
action : left_erase(0); left_erase(1); right_erase(2);

// descriptor 现已拥有基址对齐；仅添加尚不存在的纯事实，避免重复触发。
id : 36
priority : post(1)
left : store_task_descriptor(?task, ?desc) at 0
check : absense(addr_aligned(task, ALIGN_SIZE()));
action : left_add(addr_aligned(task, ALIGN_SIZE()));

// 两字段只读归还可能重建原记录；先消去 eta 展开，避免后续更新积累嵌套构造器。
id : 37
priority : post(1)
left : store_task_sched_member(?p, mkTaskSchedMemberAbs(tsmStat(?info:<TaskSchedMemberAbs>), tsmAdvanceCnt(info), tsmCurPrio(info), tsmOriginTimeslice(info), tsmRestTimeslice(info), tsmBitmapColumn(info))) at 0
action : left_erase(0); left_add(store_task_sched_member(p, info));
