#include "task_sched_view.h"

// 精确 map cell 和显式 scalar-group 需求；不打开其他 descriptor。
id : 1
priority : core(3)
left : task_fields(?sg, ?st) at 0
       task_desc_map(os_tasks(st), ?task) == Some{TaskDescriptorAbs}(?desc) at 1
right : store_task_sched_member(?p, ?info) at 2
check : infer(p == sched_link_of(task));
        infer(info == tdSchedMember(desc));
action : left_erase(0); right_erase(2);
         left_add(task_fields_except_sched(sg, st, task, desc));

id : 2
priority : core(3)
left : task_fields_except_sched(?sg, ?st, ?task, ?desc) at 0
       store_task_sched_member(?p, ?info) at 1
       task_desc_map(os_tasks(st), task) == Some{TaskDescriptorAbs}(desc) at 2
right : task_fields(sg, st) at 3
check : infer(p == sched_link_of(task));
        infer(info == tdSchedMember(desc));
action : left_erase(0); left_erase(1); right_erase(3);

id : 3
priority : post(3)
left : task_fields_except_sched(?sg, ?st, ?task, ?desc) at 0
       store_task_sched_member(?p, ?info) at 1
       task_desc_map(os_tasks(st), task) == Some{TaskDescriptorAbs}(desc) at 2
check : infer(p == sched_link_of(task));
        infer(info == tdSchedMember(desc));
action : left_erase(0); left_erase(1);
         left_add(task_fields(sg, st));

// cur_prio 只读：抽出单个槽，其余五槽保留在补集中。
id : 4
priority : core(3)
left : task_fields(?sg, ?st) at 0
       task_desc_map(os_tasks(st), ?task) == Some{TaskDescriptorAbs}(?desc) at 1
right : store(field_addr(field_addr(?q, TaskDescriptor, task_dync_sched_member), TaskDyncSchedMember, cur_prio), U8, ?value) at 2
check : infer(q == task);
action : left_erase(0); right_erase(2);
         left_add(task_fields_except_sched(sg, st, task, desc));
         left_add(store_task_sched_except_cur_prio(task, tdSchedMember(desc)));
         right_add(value == tsmCurPrio(tdSchedMember(desc)));

