#include "timeout_views.h"

id : 2
priority : timeout_unfold(1)
left : os_inv(?sg, ?st) at 0
       suspend_source_facts(sg, st, ?task) at 1
       task_desc_map(os_tasks(st), task) == Some{TaskDescriptorAbs}(?desc) at 2
       tsmStat(tdSchedMember(desc)) == TSK_SUSPEND() at 3
       In{Z}(task, sched_owned_tasks(os_tasks(st))) at 4
action : left_erase(0);
         left_add(os_global_context(sg));
         left_add(sched_link_of(task) != 0);
         left_add(sched_link_of(task) == field_addr(field_addr(task, TaskDescriptor, task_dync_sched_member), TaskDyncSchedMember, sched_link));
         left_add(timeout_global_frame(sg, st));
         left_add(task_fields(sg, st));
         left_add(assign_ready_pending(sg, st));
         left_add(store_node_self_linked(field_addr(field_addr(task, TaskDescriptor, task_dync_sched_member), TaskDyncSchedMember, sched_link)));
         left_add(suspend_source_restore(task_desc_map(os_tasks(st)), update_task_desc_map(task, set_task_desc_ready(ktask_timeout_descriptor(desc)), task_desc_map(os_tasks(st))), sg, st, task, dll_detached()));

// 非自持的已发布 SUSPEND 任务必在一个等待 DLL；仅引入该 DLL 的见证。
id : 3
priority : timeout_unfold(1)
left : os_inv(?sg, ?st) at 0
       suspend_source_facts(sg, st, ?task) at 1
       task_desc_map(os_tasks(st), task) == Some{TaskDescriptorAbs}(?desc) at 2
       tsmStat(tdSchedMember(desc)) == TSK_SUSPEND() at 3
       !In{Z}(task, sched_owned_tasks(os_tasks(st))) at 4
action : left_erase(0);
         left_exist_add(head : Z);
         left_exist_add(prefix : list{DL_Node{Z}});
         left_exist_add(suffix : list{DL_Node{Z}});
         left_add(os_global_context(sg));
         left_add(sched_link_of(task) != 0);
         left_add(sched_link_of(task) == field_addr(field_addr(task, TaskDescriptor, task_dync_sched_member), TaskDyncSchedMember, sched_link));
         left_add(timeout_global_frame(sg, st));
         left_add(task_fields(sg, st));
         left_add(assign_ready_pending(sg, st));
         left_add(store_dll{Z}(pure_suspend_sched_link(task_desc_map(os_tasks(st))), head,
           app{DL_Node{Z}}(prefix, cons{DL_Node{Z}}(Build_DL_Node{Z}(task, field_addr(field_addr(task, TaskDescriptor, task_dync_sched_member), TaskDyncSchedMember, sched_link)), suffix))));
         left_add(suspend_source_restore(task_desc_map(os_tasks(st)), update_task_desc_map(task, set_task_desc_ready(ktask_timeout_descriptor(desc)), task_desc_map(os_tasks(st))), sg, st, task, dll_linked(head, prefix, suffix)));

// 来源归还使用共享 sched_source_fold；此处只处理 Timeout 的字段更新。
id : 6
priority : timeout_prepare_ready(1)
left : assign_ready_pending(?sg, ?st) at 0
       task_fields(sg, replace_task_desc_map(update_task_desc_map(?task, replace_descriptor_exstatus(-2, ?desc), task_desc_map(os_tasks(st))), st)) at 1
action : left_erase(0);
         left_add(assign_ready_pending(sg, replace_task_desc_map(update_task_desc_map(task, replace_descriptor_exstatus(-2, desc), task_desc_map(os_tasks(st))), st)));
         left_add(task_desc_map(os_tasks(replace_task_desc_map(update_task_desc_map(task, replace_descriptor_exstatus(-2, desc), task_desc_map(os_tasks(st))), st)), task) == Some{TaskDescriptorAbs}(replace_descriptor_exstatus(-2, desc)));

// 插入完成后才提交全局资源。数学良构性由 timeout_finish 的证明提供。
id : 7
priority : timeout_fold_os(1)
left : timeout_global_frame(?sg, ?st) at 0
       suspend_source_facts(sg, st, ?task) at 1
       task_desc_map(os_tasks(st), task) == Some{TaskDescriptorAbs}(?desc) at 2
       tsmStat(tdSchedMember(desc)) == TSK_SUSPEND() at 3
       tsmBitmapColumn(tdSchedMember(desc)) == (1 << tsmCurPrio(tdSchedMember(desc))) at 4
       task_fields(sg, ?inserted) at 5
       assign_ready_pending(sg, inserted) at 6
       suspend_sched_pool(update_task_desc_map(task, set_task_desc_ready(ktask_timeout_descriptor(desc)), task_desc_map(os_tasks(st))), sg, suspend_unlink_state(task, st)) at 7
       assign_insert_step_ic(task_desc_map(os_tasks(?written : <VarGlobalState>)), task, replace_descriptor_exstatus(-2, desc), ?old_ready, ?ready) at 8
       old_ready == assignReadyVector(os_assign(written)) at 9
       inserted == replace_global_ready_vector(ready, replace_task_desc_map(update_task_desc_map(task, set_task_desc_ready(replace_descriptor_exstatus(-2, desc)), task_desc_map(os_tasks(written))), written)) at 10
check : infer(written == replace_task_desc_map(update_task_desc_map(task, replace_descriptor_exstatus(-2, desc), task_desc_map(os_tasks(st))), st));
action : left_erase(0); left_erase(5); left_erase(6); left_erase(7);
         left_add(os_inv(sg, ktask_timeout_state(st, task, desc, ready)));
