#include "delay_views_strategy.h"

// Demand-driven payload exposure. The three fields and padding exclude every link cell.
id : 1
priority : core(2)
left : store_delay_info(field_addr(?delay, Delay, link), ?info) at 0
right : store(field_addr(?base, Delay, task), PTR(struct TaskDescriptor), ?value) at 1
check : infer(base == delay);
        infer(addr_aligned(delay, ALIGN_SIZE()));
action : left_erase(0);
         left_add(store(field_addr(delay, Delay, task), PTR(struct TaskDescriptor), info.tdTaskPtr));
         left_add(store(field_addr(delay, Delay, ticks), U32, info.tdTicks));
         left_add(store(field_addr(delay, Delay, status), U8, info.tdStatus));
         left_add(CharArray::full(delay + 9, 3, cons{Z}(0, cons{Z}(0, cons{Z}(0, nil{Z})))));

id : 2
priority : core(2)
left : store_delay_info(field_addr(?delay, Delay, link), ?info) at 0
right : undef_data_at(field_addr(?base, Delay, task), PTR(struct TaskDescriptor)) at 1
check : infer(base == delay);
        infer(addr_aligned(delay, ALIGN_SIZE()));
action : left_erase(0);
         left_add(store(field_addr(delay, Delay, task), PTR(struct TaskDescriptor), info.tdTaskPtr));
         left_add(store(field_addr(delay, Delay, ticks), U32, info.tdTicks));
         left_add(store(field_addr(delay, Delay, status), U8, info.tdStatus));
         left_add(CharArray::full(delay + 9, 3, cons{Z}(0, cons{Z}(0, cons{Z}(0, nil{Z})))));

