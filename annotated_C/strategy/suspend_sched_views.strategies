id : 5
priority : suspend_fold_os(1)
left : ktask_suspend_frame(?sg, ?before, ?task) at 0
       ktask_suspend_sched_step(task, ?desc, before, ?staged) at 1
       ktask_unset_delay_step(tdDelay(update_sched_member(desc, set_sched_member_status(tdSchedMember(desc), TSK_SUSPEND()))), staged, ?after) at 2
       task_fields(sg, staged) at 3
       delay_inv(sg, after) at 4
       store_os_assign_ready_vector(field_addr(Assign, Assign, os_assign_ready_vector), assignReadyVector(os_assign(staged))) at 5
       store_node_self_linked(sched_link_of(task)) at 6
       store_prio_lookup_table() at 7
action : left_erase(0); left_erase(3); left_erase(4); left_erase(5); left_erase(6); left_erase(7);
         left_add(os_inv(sg, after));

id : 6
priority : suspend_fold_remove(1)
left : ktask_suspend_frame(?sg, ?st, ?task) at 0
       assign_remove_from_ready_ic(task, ?desc, assignReadyVector(os_assign(st)), ?ready) at 1
       0 <= tsmCurPrio(tdSchedMember(desc)) at 2
       tsmCurPrio(tdSchedMember(desc)) < PRIORITY_MAX() at 3
action : left_erase(1);
         left_add(assign_remove_running_ready(task, desc, assignReadyVector(os_assign(st)), ready));

id : 7
priority : suspend_fold_remove(1)
left : assign_remove_beyond_ready_ic(?desc, ?old_ready, ?ready) at 0
       !In{DL_Node{Z}}(sched_link_node(?task), Znth{list{DL_Node{Z}}}(tsmCurPrio(tdSchedMember(desc)), orvBuckets(old_ready), nil{DL_Node{Z}}())) at 1
action : left_erase(0);
         left_add(assign_remove_running_ready(task, desc, old_ready, ready));
