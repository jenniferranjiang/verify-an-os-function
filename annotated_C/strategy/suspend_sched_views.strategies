       store_task_status(field_addr(field_addr(task, TaskDescriptor, task_dync_sched_member), TaskDyncSchedMember, stat), TSK_SUSPEND()) at 4
       store_ktask_suspend_sched_stat_frame(sg, st, task, desc) at 5
       delay_inv(sg, st) at 6
       store_os_assign_ready_vector(?ready_ptr, ready) at 7
action : left_erase(0); left_erase(4); left_erase(5); left_erase(6); left_erase(7);
         left_exist_add(staged : <VarGlobalState>);
         left_add(staged == ktask_suspend_state(st, task, desc, ready));
         left_add(ktask_suspend_sched_step(task, desc, st, staged));
         left_add(task_desc_map(os_tasks(staged), task) == Some{TaskDescriptorAbs}(update_sched_member(desc, set_sched_member_status(tdSchedMember(desc), TSK_SUSPEND()))));
